
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notes | CollabSphere</title>

    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/responsive.css">
</head>
<body>

    <header class="navbar">
        <div class="logo">
            <a href="index.html">CollabSphere</a>
        </div>

        <nav class="navbar-links">
            <a href="dashboard.html">Dashboard</a>
            <a href="project.html">My Projects</a>
            <a href="notes.html" class="active">Notes</a>
            <a href="login.html" id="logoutLink">Logout</a>
        </nav>
    </header>

    <main class="main-content">
        <section class="notes-container">

            <div class="notes-header">
                <div>
                    <h1>My Notes</h1>
                    <p>Write down your ideas, tasks, and important reminders.</p>
                </div>
            </div>

            <section class="note-form-card">
                <h2>Create a Note</h2>

                <form id="noteForm">
                    <div class="form-group">
                        <label for="noteTitle">Note Title</label>
                        <input
                            type="text"
                            id="noteTitle"
                            placeholder="Enter note title"
                            maxlength="100"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="noteInput">Note Content</label>
                        <textarea
                            id="noteInput"
                            placeholder="Write your note here..."
                            rows="5"
                            maxlength="5000"
                            required
                        ></textarea>
                    </div>

                    <div class="form-group">
                        <label for="noteProject">Related Project (optional)</label>
                        <input
                            type="text"
                            id="noteProject"
                            placeholder="Enter project name"
                        >
                    </div>

                    <button type="submit" class="btn btn-primary" id="addNoteButton">
                        Save Note
                    </button>
                </form>
            </section>

            <section class="notes-list-section">
                <div class="notes-list-header">
                    <h2>Saved Notes</h2>

                    <input
                        type="search"
                        id="noteSearch"
                        placeholder="Search notes..."
                        aria-label="Search saved notes"
                    >
                </div>

                <p id="notesMessage" role="status"></p>

                <div class="notes-grid" id="notesList">
                    <!-- Notes are rendered here by JavaScript. -->
                </div>
            </section>

        </section>
    </main>

    <footer class="footer">
        <p>&copy; 2026 CollabSphere. All rights reserved.</p>
    </footer>

    <script src="js/api.js"></script>
    <script src="js/notes.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const form = document.getElementById("noteForm");
            const titleInput = document.getElementById("noteTitle");
            const contentInput = document.getElementById("noteInput");
            const projectInput = document.getElementById("noteProject");
            const searchInput = document.getElementById("noteSearch");
            const notesList = document.getElementById("notesList");
            const message = document.getElementById("notesMessage");
            const submitButton = document.getElementById("addNoteButton");

            const API_BASE_URL = "http://localhost:5000/api";
            let notes = [];

            function escapeHTML(value) {
                return String(value ?? "").replace(/[&<>"']/g, char => ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;"
                })[char]);
            }

            function showMessage(text, isError = false) {
                message.textContent = text;
                message.style.color = isError ? "#dc2626" : "";
            }

            async function request(path, options = {}) {
                const token = localStorage.getItem("token");

                const headers = {
                    "Content-Type": "application/json",
                    ...(token ? { Authorization: `Bearer ${token}` } : {}),
                    ...options.headers
                };

                const response = await fetch(`${API_BASE_URL}${path}`, {
                    ...options,
                    headers
                });

                const data = await response.json().catch(() => ({}));

                if (!response.ok) {
                    throw new Error(data.message || data.error || "Request failed.");
                }

                return data;
            }

            function renderNotes() {
                const query = searchInput.value.trim().toLowerCase();

                const filteredNotes = notes.filter(note => {
                    const title = String(note.title || "").toLowerCase();
                    const content = String(note.content || note.text || "").toLowerCase();
                    const project = String(note.projectName || note.project || "").toLowerCase();

                    return (
                        title.includes(query) ||
                        content.includes(query) ||
                        project.includes(query)
                    );
                });

                if (filteredNotes.length === 0) {
                    notesList.innerHTML = "";
                    showMessage(
                        notes.length
                            ? "No notes match your search."
                            : "You haven't saved any notes yet."
                    );
                    return;
                }

                showMessage("");

                notesList.innerHTML = filteredNotes.map(note => {
                    const id = note._id || note.id || "";
                    const title = escapeHTML(note.title || "Untitled Note");
                    const content = escapeHTML(note.content || note.text || "");
                    const project = escapeHTML(note.projectName || note.project || "");

                    return `
                        <article class="note-card">
                            <h3>${title}</h3>
                            <p class="note-content">${content.replace(/\n/g, "<br>")}</p>
                            ${project ? `<p class="note-project"><strong>Project:</strong> ${project}</p>` : ""}
                            <button
                                type="button"
                                class="btn btn-danger delete-note"
                                data-id="${escapeHTML(id)}"
                            >
                                Delete
                            </button>
                        </article>
                    `;
                }).join("");

                notesList.querySelectorAll(".delete-note").forEach(button => {
                    button.addEventListener("click", async () => {
                        const id = button.dataset.id;

                        if (!id || !confirm("Are you sure you want to delete this note?")) {
                            return;
                        }

                        try {
                            await request(`/notes/${encodeURIComponent(id)}`, {
                                method: "DELETE"
                            });

                            notes = notes.filter(note =>
                                String(note._id || note.id) !== id
                            );

                            renderNotes();
                            showMessage("Note deleted successfully.");
                        } catch (error) {
                            showMessage(error.message || "Could not delete note.", true);
                        }
                    });
                });
            }

            async function loadNotes() {
                showMessage("Loading notes...");

                try {
                    const data = await request("/notes");
                    notes = Array.isArray(data) ? data : data.notes || [];
                    renderNotes();
                } catch (error) {
                    notesList.innerHTML = "";
                    showMessage(
                        `${error.message} Check that the server is running and the notes API is available.`,
                        true
                    );
                }
            }

            form.addEventListener("submit", async event => {
                event.preventDefault();

                const title = titleInput.value.trim();
                const content = contentInput.value.trim();
                const projectName = projectInput.value.trim();

                if (!title || !content) {
                    showMessage("Please enter a title and note content.", true);
                    return;
                }

                submitButton.disabled = true;

                try {
                    const data = await request("/notes", {
                        method: "POST",
                        body: JSON.stringify({
                            title,
                            content,
                            projectName
                        })
                    });

                    const savedNote = data.note || data;

                    if (savedNote && (savedNote._id || savedNote.id)) {
                        notes.unshift(savedNote);
                    } else {
                        await loadNotes();
                    }

                    form.reset();
                    renderNotes();
                    showMessage("Note saved successfully.");
                } catch (error) {
                    showMessage(error.message || "Could not save note.", true);
                } finally {
                    submitButton.disabled = false;
                }
            });

            searchInput.addEventListener("input", renderNotes);

            loadNotes();
        });
    </script>

</body>
</html>
